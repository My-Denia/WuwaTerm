WUWATERM_DB_PATH=data/terms.db
WUWATERM_DATA_DIR=data/wutheringdata
WUWATERM_SOURCE_PROFILE=arikatsu

# Optional OpenAI-compatible LLM endpoint, for example LiteLLM.
WUWATERM_OPENAI_BASE_URL=
WUWATERM_OPENAI_API_KEY=
WUWATERM_OPENAI_MODEL=

# Provider reasoning for translation requests, one setting per direction
# (Chinese into English, English into Chinese): disabled, omit, low or high.
# omit sends no field, so the provider default applies, which on DeepSeek is
# high-effort thinking. disabled removes thinking; it removes the long-segment
# timeouts, which occur only into English, so it is the default into English,
# while into Chinese it lowered quality and omit is the default. Known
# regression with disabled into English: a character-mechanic name that
# contains a one-character resonator name may be rendered with the resonator
# name; set WUWATERM_TRANSLATION_THINKING_ZH_EN=omit to restore the previous
# behaviour. low and high enable thinking at that effort.
WUWATERM_TRANSLATION_THINKING_ZH_EN=disabled
WUWATERM_TRANSLATION_THINKING_EN_ZH=omit

# Core HTTP adapter. Under Compose it binds host loopback only and that bind is
# fixed in deploy/docker-compose.yml, not here: the service uses host
# networking, so making the bind an environment knob would turn a public
# exposure into a one-line edit. Port range 1..65535.
WUWATERM_API_PORT=8788
# Device credential store directory (mode 0700).
WUWATERM_API_STATE_DIR=state-api
# API budgets are per process. Invalid numeric values fail startup without
# echoing the raw value.
# Model concurrency 1..64; call and request budgets 1..10000 per minute;
# timeout 0.1..300 seconds; body cap 64..1048576 bytes; request time budget
# 1..600 seconds; long-text input ceiling 2000..16384 characters.
WUWATERM_API_LLM_MAX_CONCURRENCY=2
WUWATERM_API_LLM_CALLS_PER_MINUTE=30
WUWATERM_API_LLM_TIMEOUT_SECONDS=45
WUWATERM_API_RATE_LIMIT_PER_MINUTE=30
WUWATERM_API_MAX_BODY_BYTES=65536
WUWATERM_API_REQUEST_TIMEOUT_SECONDS=90
# WUWATERM_API_LONG_TEXT_INPUT_LIMIT=4096
# Semantic review (POST /v1/semantic-reviews) is EXPERIMENTAL and off by
# default: its evaluation did not meet the false-positive gate (ADR 0018).
# Set to 1 only on a self-hosted server whose users want model-flagged issues
# and accept the noise; public deployments leave it off. Needs a model. With
# it on, each review takes about 10-30 s (provider thinking at low effort).
# WUWATERM_SEMANTIC_REVIEW_ENABLED=1
# WUWATERM_SEMANTIC_REVIEW_TIMEOUT_SECONDS=75
# Opt-in numeric attribution hint for semantic review (ADR 0024). When both
# sides name the same stat slots with the same numbers and one number sits on a
# different stat, the review prompt gains that pairing as read-only evidence:
# the model is asked to check whether a value moved, and reports nothing when
# the attribution is valid. OFF unless set to exactly 1, true or yes; off, the
# prompt bytes are identical to a server without this switch.
# WUWATERM_SEMANTIC_REVIEW_ATTRIBUTION_HINTS=1
# How much this service writes about itself. Every request produces exactly one
# COMPLETION record (correlation id, method, route, status, duration, and the
# redacted device principal when one authenticated), written to standard error
# at INFO; the service's other diagnostic lines are unchanged and are not part
# of that one-per-request guarantee. CRITICAL, ERROR, WARNING, INFO or DEBUG,
# applied as the process level. The HTTP client library is held at WARNING or
# at this level, whichever is stricter, so a quieter setting stays quiet.
# Separate from uvicorn's own `--log-level`, which covers the web server itself
# rather than these records.
WUWATERM_API_LOG_LEVEL=INFO
# How many credential verifications may run at once. Verification is
# deliberately expensive, so this bounds it. Range 1..64.
WUWATERM_API_AUTH_MAX_CONCURRENCY=2

# Standalone client products (My-Denia/WuwaTerm-Web, My-Denia/WuwaTerm-Telegram,
# My-Denia/WuwaTerm-Windows) manage their own configuration and credentials
# outside Core. The legacy inline bot (`wuwaterm-bot`) and legacy in-process
# Python Web UI (`WUWATERM_API_WEB_ENABLED`) have been retired from Core.
# See docs/self-hosting.md and docs/sites.md.
